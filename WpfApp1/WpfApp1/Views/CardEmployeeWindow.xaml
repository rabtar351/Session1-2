<Window x:Class="WpfApp1.Views.CardEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views"
        mc:Ignorable="d"
        Title="CardEmployeeWindow" Height="450" Width="400" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="337*"/>
            <RowDefinition Height="97*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="101*"/>
            <ColumnDefinition Width="99*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" x:Name="gridBlock1" IsEnabled="False" Grid.RowSpan="2">
            <StackPanel>
                <Label Content="Имя"/>
                <TextBox x:Name="txbFirstName"/>
                <Label Content="Фамилия"/>
                <TextBox x:Name="txbLastName"/>
                <Label Content="Отчество"/>
                <TextBox x:Name="txbPatronymic" />
                <Label Content="Мобильный телефон"/>
                <TextBox x:Name="txbMobilePhone"/>
                <Label Content="День рождения"/>
                <DatePicker x:Name="dpDateBirth"/>
                <Label Content="Струтурное подразделение"/>
                <ComboBox x:Name="cmbDepartment" DisplayMemberPath="DepartmentName"/>
                <Label Content="Должность"/>
                <ComboBox x:Name="cmbPosition" DisplayMemberPath="PositionName"/>

                <Button x:Name="btnEditSave" Content="Применить" Padding="5" Margin="0,20,0,10" Click="btnEditSave_Click"/>
                <Button x:Name="btnExit" Content="Выход" Padding="5" Click="btnExit_Click" />
                <TextBlock/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Grid.RowSpan="2" x:Name="gridBlock2" IsEnabled="False" >
            <StackPanel>
                <Label Content="Непосредственный руководитель"/>
                <ComboBox x:Name="cmbDirector" DisplayMemberPath="LastName"/>
                <Label Content="Ассистент"/>
                <ComboBox x:Name="cmbAssistent" DisplayMemberPath="LastName"/>
                <Label Content="Рабочий телефон"/>
                <TextBox x:Name="txbWorkPhone"/>
                <Label Content="Электронная почта"/>
                <TextBox x:Name="txbEmail"/>
                <Label Content="Кабинет"/>
                <TextBox x:Name="txbOffice"/>
                <Label Content="Прочая инфорация"/>
                <TextBox x:Name="txbInfo" Height="80" Background="LightGray" Text=""/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button x:Name="btnEdit" Content="✏" Padding="20" Background="Bisque" Click="btnEdit_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
