<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3"
        mc:Ignorable="d" Loaded="Window_Loaded"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32*"/>
            <RowDefinition Height="185*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="399*"/>
            <ColumnDefinition Width="401*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="LightGreen">
            <Image Source="Resources/Logo.png" HorizontalAlignment="Left"/>
            <TextBlock Text="Организационная структура" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10" Width="600" Background="White"/>
        </Grid>

        <Grid Grid.Row="1" Margin="10" Background="LightGray">
            <Canvas>
                <Button Tag="btn1" Content="Дороги России" Click="Button_Click" Background="LightGreen" Canvas.Left="121" Canvas.Top="17" HorizontalAlignment="Left" VerticalAlignment="Center" Width="127" Height="25"/>
                <Button Tag="btn2" Content="Административный департамент" Click="Button_Click" Background="LightGreen" Canvas.Top="72" HorizontalAlignment="Center" VerticalAlignment="Center" Width="193" Height="24" Canvas.Left="10"/>
                <Button Tag="btn3" Content="Академия умные дороги" Click="Button_Click" Background="LightGreen" Canvas.Left="223" Canvas.Top="72" HorizontalAlignment="Center" VerticalAlignment="Center" Width="146" Height="24"/>
                <Button Tag="btn4" Content="Договорной отдел" Click="Button_Click" Background="LightGreen" Canvas.Left="10" Canvas.Top="124" HorizontalAlignment="Left" VerticalAlignment="Top" Width="130" Height="24"/>
                <Button Tag="btn5" Content="Общий отдел" Click="Button_Click" Background="LightGreen" Canvas.Left="152" Canvas.Top="124" HorizontalAlignment="Left" VerticalAlignment="Center" Width="130" Height="24"/>
                <Button Tag="btn6" Content="Лицензионный отдел" Click="Button_Click" Background="LightGreen" Canvas.Left="36" Canvas.Top="187" HorizontalAlignment="Left" VerticalAlignment="Center" Width="142" Height="24"/>
                <Button Tag="btn7" Content="Управление маркетинга" Click="Button_Click" Background="LightGreen" Canvas.Left="205" Canvas.Top="187" HorizontalAlignment="Left" VerticalAlignment="Center" Width="150" Height="24"/>
                <Rectangle Height="132" Canvas.Left="121" Stroke="Black" Width="1" RenderTransformOrigin="0.5,0.5" Canvas.Top="-9">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1"/>
                            <SkewTransform/>
                            <RotateTransform Angle="77.051"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Height="132" Canvas.Left="270" Stroke="Black" Width="1" RenderTransformOrigin="0.5,0.5" Canvas.Top="-8" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1"/>
                            <SkewTransform/>
                            <RotateTransform Angle="-77.09"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Height="132" Canvas.Left="89" Stroke="Black" Width="1" RenderTransformOrigin="0.5,0.5" Canvas.Top="44" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1"/>
                            <SkewTransform/>
                            <RotateTransform Angle="77.051"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Height="105" Canvas.Left="212" Stroke="Black" Width="1" RenderTransformOrigin="0.5,0.5" Canvas.Top="58" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1"/>
                            <SkewTransform/>
                            <RotateTransform Angle="-73.739"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Height="117" Canvas.Left="280" Stroke="Black" Width="1" RenderTransformOrigin="0.5,0.5" Canvas.Top="109" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1"/>
                            <SkewTransform/>
                            <RotateTransform Angle="-70.852"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Height="128" Canvas.Left="132" Stroke="Black" Width="1" RenderTransformOrigin="0.5,0.5" Canvas.Top="104" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1"/>
                            <SkewTransform/>
                            <RotateTransform Angle="72.454"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>
        </Grid>

        <Grid Grid.Row="2" Grid.Column="2" Margin="10">
            <ListView x:Name="ListViewEmployee" Background="LightGray" MouseDoubleClick="ListViewEmployee_MouseDoubleClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Background="LightGreen">
                            <TextBlock>
                                <Run Text="{Binding DepartmentName}"/>
                                <Run Text=" - "/>
                                <Run Text="{Binding PositionName}"/>
                            </TextBlock>

                            <TextBlock>
                                <Run Text="{Binding FirstName}"/>
                                <Run Text=""/>
                                <Run Text="{Binding LastName}"/>
                                <Run Text=""/>
                                <Run Text="{Binding Patronymic}"/>
                            </TextBlock>

                            <TextBlock>
                                <Run Text="{Binding MobilePhone}"/>
                                <Run Text=""/>
                                <Run Text="{Binding Email}"/>
                            </TextBlock>

                            <TextBlock Text="{Binding Office}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
